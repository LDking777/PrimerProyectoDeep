# Configuracion del entrenamiento (leida con python-dotenv)

# Numero de epocas
EPOCHS=5

# Tamano de los lotes
TAMANO_LOTE=32

# Semilla para que los resultados sean reproducibles
SEMILLA=42

# Silenciar el log interno de TensorFlow en consola: 0=verbose 1=avisos 2=errores 3=silencio
TF_CPP_MIN_LOG_LEVEL=2

# 1 = abre las ventanas de matplotlib (Colab/local con escritorio)
# 0 = modo headless: guarda los .png en GRAFICAS_DIR y no abre ventanas
MOSTRAR_GRAFICAS=1
GRAFICAS_DIR=graficas

# Archivo del modelo exportado en formato Keras/H5
MODELO_H5=modelo_exportado.h5

# Carpeta destino de la conversion a TensorFlow.js
# Debe coincidir con MODEL_URL del HTML: "./modelo/model.json"
RUTA_SALIDA_TFJS=modelo
